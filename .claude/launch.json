{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recipeprinter",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "recipeprinter-iso",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "NEXT_DIST_DIR=.next-preview npm run dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pdf-renderer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "pdf:dev"],
      "port": 8899
    },
    {
      "name": "recipeprinter-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "NEXT_DIST_DIR=.next-preview npx next start -p 3100"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
