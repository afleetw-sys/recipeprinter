// NOT AUTO-DEPLOYED. This repo has no `firebase.json`/CLI project link, and
// the live Firestore rules for this project (shared with CookPilot) are
// managed outside this workspace. This file documents the rules the new
// `sharedRecipeCards` collection needs — whoever manages the live rules for
// this Firebase project must add this `match` block manually (Firebase
// console, or the actual rules source of truth, wherever that is).
//
// sharedRecipeCards/{slug}: a RecipePrinter-authored share link (see
// types/sharedRecipeCard.ts). Publicly readable only while published; only
// an admin (users/{uid}.recipePrinterAdmin == true) may create or update one.
// Deliberately separate from CookPilot's own `sharedRecipes` collection.

rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedRecipeCards/{slug} {
      // `resource == null` first: a nonexistent doc has no `resource` to read
      // `.data` off, so checking `.data.published` directly would throw (and
      // deny) on every never-created slug — including the client's own
      // pre-create uniqueness check for a brand-new slug.
      allow read: if resource == null || resource.data.published == true;

      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recipePrinterAdmin == true
        && request.resource.data.createdBy == request.auth.uid;

      // Admins can update any field. Anyone else may only bump viewCount by
      // exactly 1 and touch nothing else — a scoped opening for the public
      // page-view counter that can't be used to rewrite the recipe.
      allow update: if (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recipePrinterAdmin == true)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewCount"])
          && request.resource.data.viewCount == resource.data.get("viewCount", 0) + 1);

      allow delete: if false;
    }
  }
}
