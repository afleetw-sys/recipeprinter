rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function namespacedRecipePrinterAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/products/recipePrinter/users/$(request.auth.uid)).data.recipePrinterAdmin == true;
    }

    function legacyRecipePrinterAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.recipePrinterAdmin == true;
    }

    function recipePrinterAdmin() {
      // Compatibility release: recognize both locations until the admin
      // backfill is verified, then remove the legacy half.
      return namespacedRecipePrinterAdmin() || legacyRecipePrinterAdmin();
    }

    // Recipe Printer fields carried on the shared CookPilot user document that
    // are server-owned by contract (docs/firebase-inventory.md): the admin role
    // is written by "server/admin only", `plusExpiresAt` by the "CookPilot
    // backend", and the free-template claim fields by the
    // `claimRecipePrinterFreeTemplate` callable. Nothing here is ever a client
    // write, so the rules should say so.
    function serverOwnedSharedUserFields() {
      return [
        "recipePrinterAdmin",
        "plusExpiresAt",
        "recipePrinterFreeTemplateGranted",
        "recipePrinterFreeTemplateGrantedAt"
      ];
    }

    function validRecipePrinterProfile(data) {
      return (data.email == null
          || (data.email is string && data.email.size() <= 320))
        && (data.displayName == null
          || (data.displayName is string && data.displayName.size() <= 200))
        && (data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.providerIds is list
        && data.providerIds.size() <= 10;
    }

    // ── Existing CookPilot rules ───────────────────────────────────────────
    // Kept intact while CookPilot remains on these paths.
    match /users/{userId} {
      // `recipePrinterAdmin()` falls back to reading this document, and the
      // free-template gate reads `plusExpiresAt` and the claim fields off it.
      // A blanket `allow write: if owns(userId)` therefore let any signed-in
      // user grant themselves the admin role — and with it create/update on
      // both `sharedRecipeCards` collections, which publish public indexed
      // pages — or fake an active CookPilot membership to reach the free
      // premium template. The namespaced account document already pins its
      // keys to a harmless allowlist; this document cannot, because CookPilot
      // owns its schema and writes fields this repo does not know about. So
      // deny the specific server-owned fields instead of allowlisting.
      allow read: if owns(userId);
      allow create: if owns(userId)
        && !request.resource.data.keys().hasAny(serverOwnedSharedUserFields());
      allow update: if owns(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(serverOwnedSharedUserFields());
      allow delete: if owns(userId);

      match /recipes/{recipeId} {
        allow read, write: if owns(userId);

        match /detail/{docId} {
          allow read, write: if owns(userId);
        }

        match /versions/{versionId} {
          allow read, write: if owns(userId);
        }
      }
    }

    match /app_health/{docId} {
      allow read, write: if false;
    }

    // Write-only drop box for a failed import, and the thing a human actually
    // reads when the parser gives up. One row per failure: the URL or the
    // pasted text, the category, and for an image failure a pointer to the
    // bytes in Storage (see storage.rules).
    //
    // Deliberately unauthenticated, for the same reason as the Storage drop
    // box: a signed-out visitor hitting a broken importer is the failure most
    // worth capturing, and requiring an account would blind us to exactly the
    // people we cannot email to ask.
    //
    // What bounds it is not this rule. `read` is denied, so nothing written
    // here can be read back out by a client, and `update`/`delete` are denied,
    // so a row cannot be altered or removed once collected. The shape check
    // below keeps it from becoming free document storage: a fixed set of
    // fields, a capped payload, and `product` pinned to this app so a
    // RecipePrinter row can never be mistaken for a CookPilot one. VOLUME is
    // App Check enforcement on the project, which is a console setting rather
    // than a line in this file.
    match /debugInbox/{docId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.product == "recipeprinter"
        && request.resource.data.keys().hasOnly([
          "product", "source", "category", "reason", "payload", "payloadTruncated",
          "payloadLength", "imagePath", "imageCount", "user", "userAgent", "createdAt"
        ])
        && request.resource.data.keys().hasAll(["product", "source", "category", "createdAt"])
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 20000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
    }

    match /sharedRecipes/{shareId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sharedByUserId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.sharedByUserId == request.auth.uid;

      match /items/{slug} {
        allow read: if shareId == "_slugs";
        allow write: if false;
      }
    }

    // ── Recipe Printer namespace ───────────────────────────────────────────
    match /products/recipePrinter/users/{uid} {
      // The document can contain server-owned roles, claims, purchases,
      // grants, entitlements and reconciliation state. A signed-in client may
      // create only its harmless account timestamps and subsequently refresh
      // only lastSeenAt. All other fields remain server-owned.
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          "createdAt", "lastSeenAt", "email", "displayName", "photoURL",
          "providerIds"
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && validRecipePrinterProfile(request.resource.data);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastSeenAt", "email", "displayName", "photoURL", "providerIds"
        ])
        && request.resource.data.lastSeenAt == request.time
        && validRecipePrinterProfile(request.resource.data);
      allow delete: if false;

      match /printProjects/{projectId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.id == projectId
          && request.resource.data.ownerUid == uid
          && request.resource.data.revision == 1;
        allow update: if owns(uid)
          && resource.data.ownerUid == uid
          && request.resource.data.ownerUid == uid
          && request.resource.data.id == projectId
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if owns(uid);

        // The recipes themselves. Split out of the parent document so the
        // projects list and the account menu stop downloading an entire
        // cookbook to draw a title and four thumbnails — a measured 151 kB to
        // render 1.7 kB of card, per saved book, per page load.
        //
        // No revision check here: the parent still carries `revision` and is
        // still written in the same transaction, so ordering is enforced in one
        // place rather than two that could disagree. This document holds only
        // the owner's own recipe text, and the owner may already read and write
        // all of it through the parent.
        match /content/{contentId} {
          allow read: if owns(uid);
          allow write: if owns(uid);
        }
      }

      // A cookbook unlock is the $19.99 purchase record, so it is written by the
      // server or not at all: the RevenueCat webhook grants it with the admin
      // SDK (which bypasses rules) on the purchase event, and revokes it on
      // refund/chargeback. Until this rule, the client wrote it and the rules
      // only checked ownership and key shape — no proof of purchase — so any
      // signed-in user could `setDoc` themselves the paid unlock for free.
      //
      // `read` stays open to the owner: the print page and the projects list
      // both check entitlement here, including a `list` over this collection
      // (`loadCookbookProjectUnlockIds`), which `read` covers.
      match /cookbookUnlocks/{unlockId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /products/recipePrinter/sharedRecipeCards/{slug} {
      allow read: if resource == null || resource.data.published == true;
      allow create: if recipePrinterAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if recipePrinterAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewCount"])
          && request.resource.data.viewCount == resource.data.get("viewCount", 0) + 1);
      allow delete: if false;
    }

    match /products/recipePrinter/feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly([
          "type", "message", "email", "pageUrl", "pagePath", "userAgent",
          "language", "viewport", "referrer", "status", "source", "createdAt"
        ])
        && request.resource.data.type in ["idea", "bug", "print_issue", "other"]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == "new"
        && request.resource.data.source == "recipeprinter-footer";
      allow read, update, delete: if false;
    }

    // ── Recipe Printer migration compatibility ─────────────────────────────
    // Keep these until the backfill and backend claim migration are verified.
    match /sharedRecipeCards/{slug} {
      allow read: if resource == null || resource.data.published == true;
      allow create: if recipePrinterAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if recipePrinterAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewCount"])
          && request.resource.data.viewCount == resource.data.get("viewCount", 0) + 1);
      allow delete: if false;
    }

    match /users/{uid}/printProjects/{projectId} {
      allow read, write: if owns(uid);
    }

    // The pre-namespace location. Existing docs stay readable so current owners
    // keep their books with no backfill; writes are closed here too, since this
    // path was even looser than the namespaced one it replaced.
    match /users/{uid}/cookbookUnlocks/{projectId} {
      allow read: if owns(uid);
      allow write: if false;
    }
  }
}
