# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
# Alternate dist dirs via NEXT_DIST_DIR — the preview dev server
# (.claude/launch.json) uses .next-preview, and one-off builds pick their own.
# Globbed rather than listed: a build into an unlisted dir also gets Next to add
# `<dir>/types/**/*.ts` to tsconfig.json, so an untracked one is easy to commit
# by accident along with that edit.
.next-*/
out/

# env — keep .env.local.example, never commit .env.local
.env.local
.env.*.local

# audit/prune output — contains customer ids, never commit it
revenuecat-*.csv

# misc
.DS_Store
*.pem
npm-debug.log*
firestore-debug.log
tsconfig.tsbuildinfo

# local PDF export dumps — never commit (5MB+ binaries)
export-check.pdf
scratch-export.pdf
*-export.pdf
.vercel
.env*
