# RecipePrinter calls CookPilot's Firebase Cloud Function callables directly —
# there is no separate parser. Fill these from the CookPilot Firebase web config.
# The NEXT_PUBLIC_* values are the public web config (safe to expose in-browser).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# RevenueCat Web Billing public API key for premium template purchases.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=

# PostHog product analytics. Project API key from PostHog → Settings → Project.
# Safe to expose (it's write-only). Analytics only ever boots on the canonical
# production domain, so leaving this set locally still sends nothing.
NEXT_PUBLIC_POSTHOG_KEY=

# App Check. In development, paste an App Check debug token registered in the
# Firebase project. In production, set a reCAPTCHA v3 site key instead and leave
# the debug token blank.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix — these never reach the browser).
# ---------------------------------------------------------------------------
# The two CookPilot parser endpoints. There is one recipe parser and it lives in
# CookPilot; this app only ever asks it. The URLs are not credentials — both
# endpoints are gated by the shared secret below — so they are plain config.
#
#   ...RECIPE_PARSER_URL       CookPilot fetches the URL and parses it.
#   ...SUPPLIED_HTML_PARSER_URL  We fetch (from Vercel's egress, which some sites
#                                serve when they refuse Google Cloud) and CookPilot
#                                parses what we hand it. Without this, that
#                                fallback silently does nothing.
COOKPILOT_RECIPE_PARSER_URL=https://us-central1-<project>.cloudfunctions.net/recipePrinterParseRecipeFromURL
COOKPILOT_SUPPLIED_HTML_PARSER_URL=https://us-central1-<project>.cloudfunctions.net/recipePrinterParseSuppliedHTML

# The shared secret both endpoints require, sent as X-RecipePrinter-Parser-Secret.
# This one IS a credential — mark it sensitive wherever it is stored.
RECIPEPRINTER_PARSER_SECRET=
